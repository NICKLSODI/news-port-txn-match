# ---------------------------------------------------------------- ข้อมูลลูกค้า
# ห้ามขึ้น git เด็ดขาด แม้จะปิดบังชื่อแล้ว — ยังเป็นมูลค่าพอร์ตและพฤติกรรมการเทรดจริง
# (upload.py ปฏิเสธไฟล์ที่มีอีเมล/ชื่อจริงอยู่แล้ว แต่ตัวไฟล์ทั้งก้อนก็ไม่ควรอยู่ในประวัติ)
backend/backups/
*.db
*.db-wal
*.db-shm

# ------------------------------------------------------------------------ log
logs/
*.log

# ------------------------------------------------- ของที่ลงใหม่ได้จาก lock file
node_modules/
frontend/dist/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# --------------------------------------------------- ผลลัพธ์ระหว่างทางของตัวเสนอ
# ข้อเสนอที่คนรับแล้วไปอยู่ใน app/refdata/overrides.json ซึ่ง track อยู่
# ไฟล์ในนี้เป็นของกลางทางที่ไม่ต้องเก็บประวัติ
backend/proposals/

# ----------------------------------------------------------------- ความลับ/เครื่อง
.env
.env.*
*.pem
*.key

# --------------------------------------------------------------------------- OS
.DS_Store
Thumbs.db
desktop.ini

# ตั้งใจ track ไว้:
#   memie/                       ไฟล์ spec ต้นทาง (เล็ก และเป็นที่มาของ generated.json)
#   backend/app/refdata/         overrides.json = ของที่คนอนุมัติแล้ว ทำใหม่ไม่ได้ถ้าหาย
#                                generated.json = สร้างใหม่ได้ แต่เก็บไว้ให้ clone มาแล้วรันได้เลย
